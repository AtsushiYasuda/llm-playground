# LLM Provider: "openai" or "anthropic"
LLM_PROVIDER=openai

# Model identifier
LLM_MODEL=gpt-4o

# API keys (set the one matching your provider)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Request parameters
TIMEOUT_SECONDS=60
MAX_TOKENS=4096
TEMPERATURE=0.7

# Context optimization
MAX_RESPONSE_CHARS=3000
SUMMARIZE_THRESHOLD=2000
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
